// Windows resources of Wizard.exe (src/launcher/wizard_launcher.c): its
// icon, made from the Wizard creator logo (KimmyScript/Cfg/wizard_logo.png)
// squared on a transparent background, and its version information.
#include <windows.h>

IDI_ICON1 ICON "wizard.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",     "Dirk Project"
            VALUE "FileDescription", "Wizard -- KimmyScript game sheet creator"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "InternalName",    "Wizard"
            VALUE "OriginalFilename","Wizard.exe"
            VALUE "ProductName",     "Dirk"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
