			else
			
				fontPrint(fntx, ypos, "No")
					
			end

		elseif (k == 6) then

			if ShowTop then
				
				fontPrint(fntx, ypos, "Yes")	
				
			
			else
			
				fontPrint(fntx, ypos, "No")
				
			
			end

		elseif (k == 7) then

			if ScorePos == 1 then
				
				fontPrint(fntx, ypos, "TOP")
				LivPos = 1

			elseif ScorePos == 2 then
			
				fontPrint(fntx, ypos, "BOTTOM")
				LivPos = 2

			elseif ScorePos == 3 then
			
				fontPrint(fntx, ypos, "TOP/BOTTOM")
