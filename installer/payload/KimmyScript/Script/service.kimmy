			elseif mycolor2 == 2 then
			
				fontPrint(fntx, ypos, "RED")

			elseif mycolor2 == 3 then
			
				fontPrint(fntx, ypos, "BLUE")

			elseif mycolor2 == 4 then
			
				fontPrint(fntx, ypos, "YELLOW")

